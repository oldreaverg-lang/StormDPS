# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/
*.egg-info/
dist/
build/
.env

# Cache data (large IBTrACS CSVs regenerated at runtime)
data/cache/ibtracs_all.csv
data/cache/ibtracs_recent.csv
data/cache/ibtracs_catalog.json
# NOTE: data/cache/ike/ is committed so pre-computed IKE files ship with
# the Docker image and Railway deploys don't recompute from scratch.
# DPS per-storm cache is runtime-only (written to persistent volume at runtime)
data/cache/dps/
# NRI build cache (per-zone FEMA stats; regenerated by build_nri_zones.py)
nri_build_cache.json

# Debug/analysis scripts (one-off, repo root only).
# Anchored with a leading slash so they do NOT match the tests/ package.
/analyze_*.py
/compare_*.py
/debug_*.py
/final_check.py
/get_preset_updates.py
/search_catalog.py
/show_*.py
/check_*.py
/test_*.py

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude Code session state.
# Keep project skills (.claude/skills/) tracked so they live in the monorepo,
# but never commit worktrees (full session transcripts) or local settings.
# .claude/worktrees/*/settings.local.json embeds per-command permission
# allowlists with tokenized URL fragments; a blanket "git add ." would
# otherwise re-leak the validation token.
.claude/*
!.claude/skills/
.claude/**/settings.local.json
